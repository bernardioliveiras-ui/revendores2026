# Banco MySQL Hostinger
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=mix10_revendedores
DATABASE_USER=mix10_user
DATABASE_PASSWORD=troque-por-uma-senha-forte
DATABASE_SSL=false

# Aplicação
NEXT_PUBLIC_APP_URL=https://revendedores.mix10pro.com.br
AUTH_SECRET=
ADMIN_EMAILS=seu-admin@exemplo.com.br
ADMIN_BOOTSTRAP_PASSWORD=

# Asaas
ASAAS_API_KEY=
ASAAS_ENVIRONMENT=sandbox
ASAAS_WEBHOOK_TOKEN=

# Landing / VSL opcional
VSL_EMBED_URL=
# MP4 publicado ou caminho /videos/vsl-mix10.mp4
VSL_VIDEO_URL=
# Manual exclusivo: incluído em private/manual e servido pelo portal autenticado.
# RESELLER_MANUAL_URL antigo não é usado; nunca publique o PDF em public.

# Logística: entrada de atualizações de um sistema externo contratado
# O código recebe eventos; não cria etiquetas nem agenda coleta automaticamente.
SHIPPING_WEBHOOK_TOKEN=

# Ponte para sua automação existente de boas-vindas (e-mail + WhatsApp)
# O receptor deve respeitar Idempotency-Key e responder 2xx após os dois envios.
WELCOME_AUTOMATION_URL=
WELCOME_AUTOMATION_TOKEN=

# Compatibilidade com indicações da LP externa (somente servidor)
AFFILIATE_WEBHOOK_TOKEN=
AFFILIATE_DESTINATION_URL=https://mix10pro.com.br/lp-v2

# Google / SEO (opcional, para exibir avaliações reais na LP)
GOOGLE_PLACES_API_KEY=
GOOGLE_SITE_VERIFICATION=

# E-mail automático de boas-vindas/acesso (fallback quando WELCOME_AUTOMATION_URL não estiver configurada)
RESEND_API_KEY=
WELCOME_EMAIL_FROM=LORDNUTRI <revendedor@seudominio.com.br>

# Mensuração opcional: sem IDs, nenhum SDK/banner opcional é ativado.
# NEXT_PUBLIC_* é incorporado no build: recompile depois de alterar.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Rótulo EXCLUSIVO de ação secundária "Pedido criado" (valor zero); nunca compra paga.
NEXT_PUBLIC_GOOGLE_ADS_CHECKOUT_LABEL=
NEXT_PUBLIC_META_PIXEL_ID=
# Guia de ativação e limites: docs/SEO-TRAFEGO-1.8.0.md

# Compra confirmada no servidor (opcional; nenhum envio sem ativação + credenciais)
PURCHASE_MEASUREMENT_ENABLED=false
GA4_API_SECRET=
META_CAPI_ACCESS_TOKEN=
# Versão suportada da Graph API da sua aplicação, formato vNN.0
META_GRAPH_API_VERSION=
META_CAPI_TEST_EVENT_CODE=
# Só habilite em homologação usando stream/pixel exclusivos para teste
PURCHASE_MEASUREMENT_ALLOW_SANDBOX=false
# Segredo forte exclusivo, pelo menos 32 caracteres; usado no header Bearer do retry
MEASUREMENT_RETRY_TOKEN=

# Acessos de cliente indicado: gerados manualmente no BKO ou via PowerShell.
# NENHUM RESEND_* ou WELCOME_EMAIL_FROM é obrigatório para estes acessos.
# O link de ativação de uso único é copiado pelo BKO/PowerShell e enviado privadamente.
# O endereço utilizado para BKO / PowerShell deve ser HTTPS (exceto localhost).
# NEXT_PUBLIC_APP_URL e RESEND_* podem continuar em uso em OUTRAS áreas,
# como as notificações já existentes dos revendedores — não os remova às cegas.
# Banco das indicações e comprovantes: mesmo MySQL DATABASE_* acima.

# Opcional. Ponte de pedidos entre a loja externa mix10pro.com.br e o painel
# revendedores.mix10pro.com.br. Gere segredo forte, nunca disponibilize ao browser.
INDICATOR_BRIDGE_TOKEN=
